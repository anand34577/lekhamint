<?xml version="1.0" encoding="utf-8"?>
<!-- Self-hosted servers often run on a LAN over plain HTTP or with a private CA
     (for example Caddy "tls internal"). The app warns before using plain HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
