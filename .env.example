# Copy to .env and adjust. Every setting is optional; see the Configuration wiki page.

# Address the port binds to. 127.0.0.1 (default) keeps LekhaMint private to
# this machine — sign-ins never cross the network unencrypted. Use a TLS proxy
# (deploy/docker-compose.caddy.yml) to reach it from other devices, or set
# 0.0.0.0 only if you accept plain HTTP on your LAN.
LEKHAMINT_BIND=127.0.0.1
# Port on this machine for the web app and API.
LEKHAMINT_PORT=8080
# Image tag: latest, a version like 1.1.0, or 1.1 for the newest patch of 1.1.
# A fixed version avoids surprises when `docker compose pull` updates.
LEKHAMINT_VERSION=latest
# Let anyone who can reach the server create an account. The first account can always be created.
LEKHAMINT_ALLOW_SIGNUP=false
# Set to true only when a reverse proxy (Caddy, Nginx, Traefik, Cloudflare Tunnel) sits in front.
LEKHAMINT_TRUST_PROXY=false
# Scheduled backups into /data/backups; 0 turns them off.
LEKHAMINT_BACKUP_INTERVAL=24h
LEKHAMINT_BACKUP_KEEP=14
LEKHAMINT_LOG_LEVEL=info
TZ=Asia/Kolkata

# PostgreSQL (deploy/docker-compose.postgres.yml only). Generate your own long
# random value, e.g.:  openssl rand -hex 24
POSTGRES_PASSWORD=

# HTTPS with Caddy (deploy/docker-compose.caddy.yml only)
LEKHAMINT_DOMAIN=money.example.com

# ---------------------------------------------------------------------------
# Optional features. Leave empty to keep them off.

# Address people use to reach LekhaMint, e.g. https://money.example.com.
# Needed for single sign-on and for links in emails.
LEKHAMINT_PUBLIC_URL=

# Single sign-on (Keycloak, Authentik, Authelia, Google...).
LEKHAMINT_OIDC_ISSUER=
LEKHAMINT_OIDC_CLIENT_ID=
LEKHAMINT_OIDC_CLIENT_SECRET=
LEKHAMINT_OIDC_NAME=Single sign-on
# true turns off password sign-in; make sure single sign-on works first.
LEKHAMINT_OIDC_ONLY=false

# Email notifications through an SMTP server or relay.
# LEKHAMINT_SMTP_SECURITY: starttls (port 587), tls (port 465) or none (port 25, trusted relay).
# With none, a relay that offers no login is used as it is.
LEKHAMINT_SMTP_HOST=
LEKHAMINT_SMTP_PORT=
LEKHAMINT_SMTP_USER=
LEKHAMINT_SMTP_PASSWORD=
LEKHAMINT_SMTP_FROM=LekhaMint <no-reply@example.com>
LEKHAMINT_SMTP_SECURITY=starttls
# true accepts a self-signed or mismatched certificate on an internal relay.
LEKHAMINT_SMTP_SKIP_VERIFY=false
# Hour of the day (server time, 0-23) for bill and budget reminders; -1 turns them off.
LEKHAMINT_REMINDER_HOUR=8

# Gotify push notifications. Each person adds their own application token in Settings.
LEKHAMINT_GOTIFY_URL=

# Assistant through the server: any OpenAI-compatible API (OpenAI, Ollama, ...).
LEKHAMINT_AI_BASE_URL=
LEKHAMINT_AI_API_KEY=
LEKHAMINT_AI_MODEL=
