# systemd unit for bare-metal Linux.
#   sudo useradd --system --home /var/lib/kosh --shell /usr/sbin/nologin kosh
#   sudo install -m 0755 kosh /usr/local/bin/kosh
#   sudo cp kosh.service /etc/systemd/system/ && sudo systemctl enable --now kosh
[Unit]
Description=LekhaMint expense manager sync server
After=network-online.target
Wants=network-online.target

[Service]
User=kosh
Group=kosh
ExecStart=/usr/local/bin/kosh serve
Restart=on-failure
RestartSec=5s
StateDirectory=kosh
Environment=KOSH_DATA_DIR=/var/lib/kosh
Environment=KOSH_ADDR=127.0.0.1:8080
Environment=KOSH_LOG_FORMAT=json
# Optional overrides: /etc/kosh/kosh.env (KOSH_* variables, one per line)
EnvironmentFile=-/etc/kosh/kosh.env

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/kosh

[Install]
WantedBy=multi-user.target
